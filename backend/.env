# ========================================================
#  EVOLVIA TECHNOLOGIES — BACKEND ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Server Port (Default: 4000)
PORT=4000

# 2. Database Connection
# If MongoDB is not installed or offline, Evolvia automatically runs
# in high-speed, persistent file-backed mode (data/leads.json).
# For cloud MongoDB Atlas, paste your connection string below:
MONGODB_URI=mongodb://127.0.0.1:27017/evolvia_crm

# 3. SMTP Cold Email Credentials (OPTIONAL)
# If left empty, emails run in safe 'SIMULATION MODE' (logged to console & CRM).
# To send REAL emails via Gmail:
# - Go to Google Account > Security > 2-Step Verification > App Passwords
# - Generate a 16-character App Password and paste below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_NAME="Evolvia Technologies"

# 4. Lead Hunter & Automated Follow-Up Interval (in Days)
FOLLOW_UP_INTERVAL_DAYS=3
